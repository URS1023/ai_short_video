# Copy to .env (never commit .env). Real environment variables override this file.

# ---- Image generation: any OpenAI-compatible Images API ----
IMAGE_API_BASE_URL=https://your-provider.example/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
# Request size; the provider may deliver a nearby size, scripts normalise to the canvas.
IMAGE_SIZE=1152x2048
IMAGE_CONCURRENCY=5
IMAGE_CANDIDATES=2

# ---- Local image-to-video: ComfyUI instances (one job runs per instance) ----
COMFY_URLS=http://192.168.1.10:8188,http://192.168.1.10:8189

# ---- Canvas defaults for init_project_style.mjs ----
# HBG_ORIENTATION=portrait
# HBG_SIZE=768x1344
